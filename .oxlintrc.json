{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error",
    "nursery": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "globals": {
    "Bun": "readonly"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "maxWarnings": 0
  },
  "rules": {
    "eslint/max-lines": [
      "error",
      {
        "max": 600,
        "skipBlankLines": false,
        "skipComments": false
      }
    ],
    "eslint/one-var": ["error", "never"],
    "eslint/func-style": [
      "error",
      "declaration",
      {
        "allowArrowFunctions": true
      }
    ],
    "eslint/sort-imports": [
      "error",
      {
        "ignoreDeclarationSort": true
      }
    ],
    "eslint/no-duplicate-imports": [
      "error",
      {
        "allowSeparateTypeImports": true
      }
    ],
    "eslint/max-statements": ["error", 20],
    "eslint/max-lines-per-function": [
      "error",
      {
        "max": 80,
        "skipBlankLines": false,
        "skipComments": false
      }
    ],
    "unicorn/max-nested-calls": [
      "error",
      {
        "max": 5
      }
    ],
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "ignoreInferredTypes": true,
        "treatMethodsAsReadonly": true,
        "allow": [
          {
            "from": "package",
            "name": "ZodType",
            "package": "zod"
          },
          {
            "from": "lib",
            "name": "Request"
          }
        ]
      }
    ],
    "eslint/id-length": [
      "error",
      {
        "min": 2,
        "properties": "never"
      }
    ],
    "eslint/no-void": [
      "error",
      {
        "allowAsStatement": true
      }
    ],
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "eslint/sort-keys": "off",
    "eslint/no-ternary": "off",
    "eslint/default-case": "off",
    "eslint/no-magic-numbers": [
      "error",
      {
        "ignore": [-1, 0, 1],
        "ignoreArrayIndexes": true,
        "enforceConst": true
      }
    ],
    "eslint/require-await": "off",
    "eslint/no-undefined": "off",
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "import/no-relative-parent-imports": "off",
    "import/no-nodejs-modules": "off",
    "oxc/no-async-await": "off",
    "oxc/no-optional-chaining": "off",
    "oxc/no-rest-spread-properties": "off"
  },
  "overrides": [
    {
      "files": ["tests/**"],
      "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node", "jest"],
      "rules": {
        "typescript/require-await": "off"
      }
    },
    {
      "files": ["src/app/**", "scripts/**"],
      "rules": {
        "node/no-top-level-await": "off",
        "eslint/no-console": "off"
      }
    },
    {
      "files": ["src/agent/loop.ts", "src/computer/browser-adapter.ts"],
      "rules": {
        "eslint/no-await-in-loop": "off"
      }
    }
  ],
  "ignorePatterns": ["runs/**", "node_modules/**", "integrations/**"]
}
