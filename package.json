{
  "name": "system-one-computer-use",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/app/cli.ts",
    "test": "bun test ./tests",
    "lint": "oxlint --max-warnings 0 --report-unused-disable-directives",
    "check": "oxlint --type-aware --type-check --max-warnings 0 --report-unused-disable-directives && bun scripts/check-source-size.ts",
    "format": "oxfmt --write src tests scripts README.md AGENTS.md docs integrations/clm-mlx/README.md .oxlintrc.json .oxfmtrc.json tsconfig.json package.json",
    "format:check": "oxfmt --check src tests scripts README.md AGENTS.md docs integrations/clm-mlx/README.md .oxlintrc.json .oxfmtrc.json tsconfig.json package.json",
    "app:install": "bun scripts/install-macos.ts",
    "test:native": "bun scripts/test-native.ts",
    "eval:decisions": "bun scripts/evals/decisions.ts",
    "eval:browser": "bun scripts/evals/browser-tasks.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@playwright/mcp": "^0.0.82",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.9.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "^1.4.2",
    "@types/proper-lockfile": "^4.1.4",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "type-fest": "^5.10.0"
  }
}
