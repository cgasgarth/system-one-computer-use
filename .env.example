# Any compatible System One endpoint. CLM is one local example.
SYSTEM_ONE_URL=http://127.0.0.1:8700/v1/systemone
SYSTEM_ONE_MODEL=clm-latest
# SYSTEM_ONE_API_KEY=

TEXT_MODEL_URL=http://127.0.0.1:8080/v1/chat/completions
TEXT_MODEL_ID=default_model
# TEXT_MODEL_API_KEY=

# Requires ChatGPT/Codex Computer Use and Codex Chrome setup.
SYSTEM_ONE_CONTROL_SURFACE=auto
